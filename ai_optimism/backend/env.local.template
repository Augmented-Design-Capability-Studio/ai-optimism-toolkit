# Cloudflare Tunnel configuration
# Copy this file to .env and set your tunnel name
# The tunnel credentials should be configured in ~/.cloudflared/config.yml
# Tunnel name (required): The name of your Cloudflare tunnel (e.g., "aiopt")
# For local development, keep these empty
CLOUDFLARE_TUNNEL_NAME=
# Tunnel domain (optional): Your custom domain/subdomain for the tunnel
# If not set, the tunnel will use Cloudflare's default URL
# Example: CLOUDFLARE_TUNNEL_DOMAIN=api.yourdomain.com
CLOUDFLARE_TUNNEL_DOMAIN=



